# BelowYourMeans Configuration
# Copy this file to .env.local for local development
# Cloudflare runtime secrets belong in .dev.vars locally and Worker secrets remotely.

# REQUIRED: Your app password (this is what you'll use to login)
APP_PASSWORD=your-secure-password-here

# REQUIRED: A secret key for session management (generate a random string)
# You can generate one with: openssl rand -hex 32
SESSION_SECRET=your-secret-key-here

# OPTIONAL: Set to false if not using HTTPS (default: true in production)
# SECURE_COOKIES=false

# OPTIONAL: Custom database path (defaults to ./data/belowyourmeans.db)
# DATABASE_PATH=/custom/path/to/database.db

# Voice entry: put OPENAI_API_KEY in .dev.vars for the local Worker runtime.
# Use .dev.vars.example for server-side model defaults. Never expose the key as NEXT_PUBLIC_.
