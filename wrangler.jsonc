{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "below-your-means",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "below-your-means"
    }
  ],
  "vars": {
    "OPENAI_TRANSCRIBE_MODEL": "gpt-4o-mini-transcribe",
    "OPENAI_PARSE_MODEL": "gpt-4.1-mini"
  },
  "ratelimits": [
    {
      "name": "VOICE_RATE_LIMITER",
      "namespace_id": "9192026",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "below-your-means",
      "database_id": "e52799c3-8dc0-4509-96f9-7511eda3c140",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
